<UserControl x:Class="PrivChat.Overlay.LlmSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <SolidColorBrush x:Key="LlmLineBrush" Color="#405149" />
        <SolidColorBrush x:Key="LlmTextBrush" Color="#F2F8F5" />
        <SolidColorBrush x:Key="LlmMutedBrush" Color="#A8B8B1" />
        <SolidColorBrush x:Key="LlmBubbleBrush" Color="#2E4A5A" />
        <SolidColorBrush x:Key="LlmUserBrush" Color="#0B7F68" />
        <SolidColorBrush x:Key="LlmErrorBrush" Color="#5A2E2E" />
        <Style x:Key="LlmBorderStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="MaxWidth" Value="280" />
            <Setter Property="Margin" Value="0,4,44,4" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{StaticResource LlmBubbleBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Role}" Value="user">
                    <Setter Property="HorizontalAlignment" Value="Right" />
                    <Setter Property="Margin" Value="44,4,0,4" />
                    <Setter Property="Background" Value="{StaticResource LlmUserBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="error">
                    <Setter Property="Background" Value="{StaticResource LlmErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LlmToolButton" TargetType="Button">
            <Setter Property="Background" Value="#2A3630" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <!-- Everything here lives inside the capture-protected overlay window: no dialogs,
         no popups, nothing that could appear in a screenshot or screen share. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="12,8,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Runs 100% on this PC — nothing leaves your machine"
                       Foreground="{StaticResource LlmMutedBrush}" FontSize="10"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <Button x:Name="EditEndpointButton" Grid.Column="1" Content="✎ server" Click="EditEndpoint_Click"
                    FontSize="10" Padding="8,3" Margin="8,0,0,0" Style="{StaticResource LlmToolButton}" />
        </Grid>

        <ScrollViewer x:Name="LlmScroll" Grid.Row="1" Padding="12" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Messages}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource LlmBorderStyle}">
                            <StackPanel>
                                <TextBlock Text="{Binding Body}" Foreground="{StaticResource LlmTextBrush}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding TimeText}" Foreground="#C8D6D0" FontSize="10" HorizontalAlignment="Right" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel x:Name="EndpointPanel" Grid.Row="1" Visibility="Collapsed" Margin="16,10">
            <TextBlock Text="LLM server URL" Foreground="{StaticResource LlmTextBrush}" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="EndpointBox" MaxLength="200" Padding="8,6" Background="#F4F7F5" Foreground="#111815" BorderThickness="0" />
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Content="Save" Click="SaveEndpoint_Click"
                        Padding="16,6" Background="#0B7F68" Foreground="White" BorderThickness="0" Cursor="Hand" />
                <Button x:Name="CancelEndpointButton" Content="Cancel" Click="CancelEndpoint_Click"
                        Padding="16,6" Margin="8,0,0,0" Style="{StaticResource LlmToolButton}" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock x:Name="EndpointError" Foreground="#E0A0A0" FontSize="11" Margin="0,8,0,0"
                       TextWrapping="Wrap" Visibility="Collapsed" />
            <TextBlock Text="Default http://127.0.0.1:1234 — your START HERE.bat server, no key needed"
                       Foreground="{StaticResource LlmMutedBrush}" FontSize="10" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="BusyText" Grid.Row="2" Text="Local model is thinking… an image takes ~15 s" FontStyle="Italic"
                   Foreground="{StaticResource LlmMutedBrush}" FontSize="11" Margin="12,0,12,4" Visibility="Collapsed" />

        <Border x:Name="AttachmentStrip" Grid.Row="3" Margin="12,0,12,4" Background="#2A3630"
                CornerRadius="6" Padding="6" HorizontalAlignment="Left" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="Thumbnail" Height="56" Stretch="Uniform" />
                <Button Content="×" Click="RemoveAttachment_Click" FontSize="14" Background="Transparent"
                        Foreground="{StaticResource LlmMutedBrush}" BorderThickness="0" Margin="6,0,0,0" Cursor="Hand" />
            </StackPanel>
        </Border>

        <Grid x:Name="InputBar" Grid.Row="4" Margin="12,0,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="42" />
            </Grid.ColumnDefinitions>
            <Button x:Name="CameraButton" Grid.Column="0" Content="📷" Click="Camera_Click" FontSize="15"
                    Width="38" Margin="0,0,8,0" Style="{StaticResource LlmToolButton}" />
            <TextBox x:Name="PromptBox" Grid.Column="1" MinHeight="38" MaxLength="4000"
                     VerticalContentAlignment="Center" Padding="12,0" KeyDown="PromptBox_KeyDown"
                     Background="#F4F7F5" Foreground="#111815" BorderThickness="0" />
            <Button x:Name="SendButton" Grid.Column="3" Content=">" Click="Send_Click" FontSize="18" FontWeight="Bold"
                    Background="#0B7F68" Foreground="White" BorderThickness="0" Cursor="Hand" />
        </Grid>
    </Grid>
</UserControl>
