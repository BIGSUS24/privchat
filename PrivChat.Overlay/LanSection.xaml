<UserControl x:Class="PrivChat.Overlay.LanSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#202824">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Rooms on this network" Foreground="#A8B8B1" FontSize="11" Margin="0,0,0,6" />

        <ListBox Grid.Row="1" x:Name="RoomList" Background="#18201C" Foreground="#F2F8F5"
                 BorderBrush="#405149" BorderThickness="1" HorizontalContentAlignment="Stretch"
                 MouseDoubleClick="RoomList_MouseDoubleClick">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,2">
                        <Ellipse Width="8" Height="8" Fill="#73C6A6" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Foreground="#F2F8F5" Margin="8,0,0,0" />
                        <TextBlock Text="{Binding Address}" Foreground="#A8B8B1" FontSize="11" Margin="10,0,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox Grid.Row="0" x:Name="HostBox" Padding="8,6" Background="#F4F7F5" Foreground="#111815"
                     BorderThickness="0" ToolTip="Host IP:port, filled by double-clicking a room" />
            <TextBox Grid.Row="1" x:Name="CodeBox" Padding="8,6" Margin="0,6,0,0" Background="#F4F7F5"
                     Foreground="#111815" BorderThickness="0" MaxLength="6"
                     ToolTip="Pair code shown on the host's overlay" />

            <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Vertical" Margin="8,0,0,0">
                <Button x:Name="JoinButton" Content="Join" Click="Join_Click" Padding="14,6" Margin="0,0,0,6"
                        Background="#0B7F68" Foreground="White" BorderThickness="0" Cursor="Hand" />
                <Button x:Name="LeaveButton" Content="Leave" Click="Leave_Click" Padding="14,6"
                        Background="#2A3630" Foreground="White" BorderThickness="0" Cursor="Hand" />
            </StackPanel>

            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" x:Name="StatusText" Text="Not connected to a room."
                       Foreground="#A8B8B1" FontSize="11" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>
